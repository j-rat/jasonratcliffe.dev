---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ title: p.data.title, href: `/blog/${p.id}/`, date: p.data.date.toISOString().slice(0, 10) }));
---
<dialog id="terminal" class="term" aria-labelledby="term-title" data-posts={JSON.stringify(posts)}>
  <div class="chrome">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <h2 id="term-title">guest@jasonratcliffe: ~</h2>
    <button type="button" class="close" data-terminal-close aria-label="Close terminal">esc</button>
  </div>
  <div class="screen" data-terminal-screen>
    <div class="out" data-terminal-out role="log" aria-live="polite"></div>
    <form class="line" data-terminal-form autocomplete="off">
      <label for="term-input" class="ps1"><span class="u">guest</span>@<span class="h">jasonratcliffe</span>:<span class="p">~</span>$</label>
      <input id="term-input" name="cmd" type="text" spellcheck="false" autocapitalize="off" aria-label="Terminal command" data-terminal-input />
    </form>
  </div>
</dialog>

<script>
  import { initTerminal } from '../scripts/terminal';
  initTerminal();
</script>

<style>
  .term {
    width: min(860px, calc(100vw - 24px));
    height: min(560px, calc(100vh - 48px));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: #03060a;
    color: #c9f7ee;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(45, 212, 191, 0.15);
    overflow: hidden;
  }
  .term[open] { display: flex; flex-direction: column; }
  .term::backdrop { background: rgba(2, 4, 7, 0.7); backdrop-filter: blur(3px); }
  .chrome {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--bg-raised);
  }
  .chrome h2 { font: 500 0.82rem var(--mono); margin: 0 auto; color: var(--text-muted); }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #3a4452; }
  .lights i:first-child { background: #f87171; }
  .lights i:nth-child(2) { background: #fbbf24; }
  .lights i:nth-child(3) { background: #4ade80; }
  .close {
    font: 600 0.75rem var(--mono); color: var(--text-muted); background: none;
    border: 1px solid var(--line-strong); border-radius: 5px; padding: 4px 8px; cursor: pointer;
  }
  .close:hover { color: var(--text); border-color: var(--accent); }
  .screen { flex: 1; overflow-y: auto; padding: 14px 16px; font: 0.88rem/1.55 var(--mono); }
  .out :global(p) { margin: 0; white-space: pre-wrap; word-break: break-word; }
  .out :global(.cmd) { color: var(--text); }
  .out :global(.dim) { color: var(--text-muted); }
  .out :global(.acc) { color: var(--accent); }
  .out :global(.warn) { color: var(--warn); }
  .out :global(.err) { color: var(--danger); }
  .out :global(.ok) { color: var(--ok); }
  .out :global(a) { color: var(--accent-strong); }
  .out :global(pre) { margin: 0; font: inherit; color: var(--accent); }
  .line { display: flex; gap: 8px; align-items: baseline; }
  .ps1 { white-space: nowrap; color: var(--text-muted); }
  .ps1 .u { color: var(--ok); }
  .ps1 .h { color: var(--accent); }
  .ps1 .p { color: #93c5fd; }
  .line input {
    flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
    color: var(--text); font: inherit; caret-color: var(--accent);
  }
</style>
