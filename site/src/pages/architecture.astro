---
import Base from '../layouts/Base.astro';

// Generic labels only: no account IDs, ARNs or real resource names on this page.
const controls = [
  { layer: 'DNS', what: 'Route 53 hosted zone', controls: ['Alias records to the CDN (no IPs to drift)', 'CAA records allow only Amazon to issue certificates', 'SPF, DKIM and DMARC for the mail domain'] },
  { layer: 'Edge / TLS', what: 'CloudFront + ACM certificate', controls: ['TLS 1.2+ (TLSv1.2_2021 policy), HTTP → HTTPS redirect', 'HTTP/2 and HTTP/3', 'Edge function: www → apex redirect, clean URLs', 'Access logs exclude viewer IPs, X-Forwarded-For and cookies at the source'] },
  { layer: 'Headers', what: 'Response headers policy', controls: ['HSTS (2 years, includeSubDomains, preload)', 'Strict CSP: self-only scripts, no inline script, frame-ancestors none', 'nosniff, Referrer-Policy, Permissions-Policy, COOP/CORP', 'PDF served with its own headers policy (no CSP) so browser PDF viewers work'] },
  { layer: 'Origin', what: 'Private S3 bucket', controls: ['Block Public Access on, ACLs disabled (bucket owner enforced)', 'Origin Access Control: bucket policy allows only this distribution', 'SSE encryption, versioning for instant rollback, TLS-only bucket policy', 'data/ is written only by the edge report and excluded from deploy deletes'] },
  { layer: 'Contact API', what: 'HTTP API → Lambda → SES', controls: ['Same-origin route through the CDN (no CORS, no extra CSP origin)', 'Stage throttling returns 429 on bursts; honeypot drops bots', 'Every outcome is logged as a count-only event: no names, addresses or message text', 'Secret origin header so the API only answers the CDN', 'Lambda role can send only from the site domain identity; recipient never leaves the backend', 'Lambda role runs under a permissions boundary'] },
  { layer: 'Detection', what: 'Edge telemetry', controls: ['CloudFront access logs to CloudWatch Logs (30-day retention); viewer IPs, X-Forwarded-For and cookies are never logged', 'A daily EventBridge schedule runs a Lambda that maps probes to MITRE ATT&CK with Logs Insights', 'Leak check flags any file probe (.env, .git, backups) that received a 200', 'Contact form defenses charted for 30 days: honeypot catches, direct-API bypass, cross-site posts, throttling, rejected input', 'The report Lambda can query only the access-log and contact-log groups and write one object', 'Results are public on /edge/: no IPs, no query strings, sanitized paths, real messages never counted'] },
  { layer: 'IaC', what: 'Terraform', controls: ['Two stacks: bootstrap (state, DNS zone, OIDC roles) applied locally; main applied only by CI', 'Remote state in a dedicated S3 bucket: versioned, encrypted, public access blocked, TLS-only', 'Native S3 state locking', 'Every workload role carries a permissions boundary', 'Account-specific values kept out of git'] },
  { layer: 'CI/CD', what: 'GitHub Actions', controls: ['OIDC federation – no long-lived AWS keys anywhere', 'OIDC trust pinned to immutable owner and repo IDs', 'PRs assume a read-only plan role; deploys wait for manual approval in a protected environment, and only main can deploy', 'Actions pinned to commit SHAs; dependency updates verified before merge', 'Build fails if the PII scanner finds an email, phone or address', 'Live smoke tests after every deploy: headers, redirects, direct S3 = 403, security.txt, /edge/ data (tagged so they never count as abuse)'] },
];
---
<Base title="Architecture" description="How jasonratcliffe.dev is hosted and secured on AWS." active="architecture">
  <div class="wrap page">
    <p class="eyebrow">Architecture</p>
    <h1>How this site is hosted and secured</h1>
    <p class="lead muted">A static site with two small serverless functions, deployed by Terraform from GitHub Actions. Everything a visitor touches goes through the CDN; nothing else is reachable from the internet.</p>

    <figure class="card diagram">
      <svg viewBox="0 0 1000 680" role="img" aria-labelledby="arch-title arch-desc">
        <title id="arch-title">Architecture diagram</title>
        <desc id="arch-desc">Visitors resolve the domain in Route 53 and connect over TLS to CloudFront. CloudFront adds security headers (the PDF has its own policy) and serves static files from a private S3 bucket through Origin Access Control. Requests to /api/contact go to a throttled HTTP API, which invokes a Lambda function that checks a honeypot field and sends mail through Amazon SES to an inbox that is never published; it logs each outcome, without personal data, to CloudWatch Logs. CloudFront access logs, without viewer IPs or cookies, go to CloudWatch Logs; a daily EventBridge schedule runs an edge report Lambda that queries both log sets, maps probes to MITRE ATT&amp;CK, counts what the contact form blocked and writes a summary into the site bucket for the /edge/ page. GitHub Actions authenticates to AWS with OIDC roles to run Terraform, whose state is stored in a separate S3 bucket, and to deploy: apply, sync files, run the report and invalidate the cache.</desc>
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0L10 5L0 10z" class="arrowhead" />
          </marker>
        </defs>

        <rect x="200" y="20" width="780" height="468" rx="14" class="boundary" />
        <text x="216" y="44" class="boundary-label">AWS · us-east-1 · single account</text>

        <g class="node">
          <rect x="20" y="180" width="140" height="70" rx="10" />
          <text x="90" y="211" class="title">Visitor</text>
          <text x="90" y="231" class="sub">browser</text>
        </g>
        <g class="node">
          <rect x="230" y="60" width="210" height="60" rx="10" />
          <text x="335" y="86" class="title">Route 53</text>
          <text x="335" y="106" class="sub">alias · CAA · DKIM · SPF</text>
        </g>
        <g class="node accent">
          <rect x="230" y="150" width="250" height="130" rx="10" />
          <text x="355" y="178" class="title">CloudFront</text>
          <text x="355" y="200" class="sub">ACM cert · TLS 1.2+ · HTTP/3</text>
          <text x="355" y="218" class="sub">security headers policy</text>
          <text x="355" y="236" class="sub">PDF: own policy, no CSP</text>
          <text x="355" y="254" class="sub">edge fn: redirects</text>
        </g>
        <g class="node">
          <rect x="560" y="60" width="220" height="76" rx="10" />
          <text x="670" y="88" class="title">HTTP API</text>
          <text x="670" y="108" class="sub">POST /api/contact</text>
          <text x="670" y="125" class="sub">throttled · origin secret</text>
        </g>
        <g class="node ghost">
          <rect x="820" y="60" width="150" height="76" rx="10" />
          <text x="895" y="92" class="title">Inbox</text>
          <text x="895" y="112" class="sub">never public</text>
        </g>
        <g class="node">
          <rect x="560" y="166" width="220" height="64" rx="10" />
          <text x="670" y="192" class="title">Contact Lambda</text>
          <text x="670" y="212" class="sub">validate · honeypot</text>
        </g>
        <g class="node">
          <rect x="820" y="166" width="150" height="64" rx="10" />
          <text x="895" y="192" class="title">SES</text>
          <text x="895" y="212" class="sub">DKIM · DMARC</text>
        </g>
        <g class="node">
          <rect x="560" y="262" width="220" height="96" rx="10" />
          <text x="670" y="288" class="title">S3 site bucket</text>
          <text x="670" y="307" class="sub">private · OAC only</text>
          <text x="670" y="324" class="sub">encrypted · versioned</text>
          <text x="670" y="341" class="sub">+ data/edge-threats.json</text>
        </g>
        <g class="node">
          <rect x="230" y="388" width="210" height="80" rx="10" />
          <text x="335" y="414" class="title">CloudWatch Logs</text>
          <text x="335" y="434" class="sub">CDN + contact logs · 30 d</text>
          <text x="335" y="451" class="sub">no IP · cookie · XFF</text>
        </g>
        <g class="node accent">
          <rect x="560" y="388" width="220" height="80" rx="10" />
          <text x="670" y="414" class="title">Edge report Lambda</text>
          <text x="670" y="434" class="sub">ATT&amp;CK map · form stats</text>
          <text x="670" y="451" class="sub">writes data/* only</text>
        </g>
        <g class="node">
          <rect x="820" y="388" width="150" height="80" rx="10" />
          <text x="895" y="414" class="title">EventBridge</text>
          <text x="895" y="434" class="sub">daily schedule</text>
          <text x="895" y="451" class="sub">00:15 UTC</text>
        </g>

        <path d="M160 196 C 190 170, 200 96, 230 90" class="edge" marker-end="url(#arrow)" />
        <text x="164" y="140" class="edge-label">1 DNS</text>
        <path d="M160 226 L 230 226" class="edge strong" marker-end="url(#arrow)" />
        <text x="166" y="250" class="edge-label">2 HTTPS</text>
        <path d="M480 172 C 520 160, 520 100, 560 98" class="edge strong" marker-end="url(#arrow)" />
        <text x="490" y="86" class="edge-label">/api/*</text>
        <path d="M480 260 C 520 262, 520 310, 560 310" class="edge strong" marker-end="url(#arrow)" />
        <text x="490" y="332" class="edge-label">/* OAC</text>
        <path d="M670 136 L 670 166" class="edge" marker-end="url(#arrow)" />
        <path d="M780 198 L 820 198" class="edge" marker-end="url(#arrow)" />
        <path d="M895 166 L 895 136" class="edge" marker-end="url(#arrow)" />
        <path d="M335 280 L 335 388" class="edge" marker-end="url(#arrow)" />
        <text x="343" y="338" class="edge-label">access logs</text>
        <path d="M560 222 C 520 236, 470 330, 432 388" class="edge" marker-end="url(#arrow)" />
        <text x="452" y="372" class="edge-label">outcomes</text>
        <path d="M440 428 L 560 428" class="edge" marker-end="url(#arrow)" />
        <text x="480" y="420" class="edge-label">query</text>
        <path d="M820 428 L 780 428" class="edge" marker-end="url(#arrow)" />
        <path d="M670 388 L 670 358" class="edge" marker-end="url(#arrow)" />
        <text x="678" y="378" class="edge-label">PutObject</text>

        <rect x="20" y="510" width="960" height="150" rx="14" class="boundary dashed" />
        <text x="36" y="534" class="boundary-label">Delivery</text>

        <g class="node">
          <rect x="40" y="546" width="220" height="96" rx="10" />
          <text x="150" y="572" class="title">GitHub Actions</text>
          <text x="150" y="592" class="sub">PR plan · main apply</text>
          <text x="150" y="609" class="sub">approval gate · PII scan</text>
          <text x="150" y="626" class="sub">smoke tests · Dependabot</text>
        </g>
        <g class="node">
          <rect x="320" y="546" width="220" height="96" rx="10" />
          <text x="430" y="572" class="title">IAM OIDC roles</text>
          <text x="430" y="592" class="sub">short-lived creds</text>
          <text x="430" y="609" class="sub">immutable repo IDs</text>
          <text x="430" y="626" class="sub">boundary on new roles</text>
        </g>
        <g class="node">
          <rect x="620" y="546" width="220" height="96" rx="10" />
          <text x="730" y="572" class="title">Terraform state</text>
          <text x="730" y="592" class="sub">own S3 bucket</text>
          <text x="730" y="609" class="sub">versioned · locked</text>
          <text x="730" y="626" class="sub">bootstrap + main</text>
        </g>
        <path d="M260 594 L 320 594" class="edge" marker-end="url(#arrow)" />
        <text x="272" y="584" class="edge-label">OIDC</text>
        <path d="M540 594 L 620 594" class="edge" marker-end="url(#arrow)" />
        <text x="548" y="584" class="edge-label">plan/apply</text>
        <path d="M430 546 L 430 490" class="edge dashed-edge" marker-end="url(#arrow)" />
        <text x="440" y="504" class="edge-label">deploy: apply · sync · run report · invalidate</text>
      </svg>
      <figcaption class="muted mono">Teal arrows: request path. Grey: mail, logging and the daily report. Dashed: deployment. Nothing outside the CDN is publicly reachable; the S3 website endpoint is not used.</figcaption>
    </figure>

    <h2 class="sec">Controls by layer</h2>
    <div class="layers">
      {controls.map((c) => (
        <article class="card">
          <p class="mono layer">{c.layer}</p>
          <h3>{c.what}</h3>
          <ul>{c.controls.map((x) => <li>{x}</li>)}</ul>
        </article>
      ))}
    </div>

    <p class="muted mono note">Want to verify? <code>curl -sI https://jasonratcliffe.dev</code> shows every header above. The infrastructure is written in Terraform – read about it on the <a href="/blog/">blog</a>. See who is probing the site on the <a href="/edge/">edge telemetry</a> page.</p>
  </div>
</Base>

<style>
  .page { padding-top: 48px; padding-bottom: 32px; }
  .lead { max-width: 70ch; font-size: 1.08rem; }
  .diagram { margin: 28px 0 0; padding: 12px; overflow-x: auto; }
  .diagram svg { width: 100%; min-width: 640px; height: auto; display: block; }
  .diagram figcaption { font-size: 0.78rem; padding: 8px 6px 2px; }
  .boundary { fill: rgba(45, 212, 191, 0.03); stroke: var(--line-strong); stroke-width: 1.5; }
  .boundary.dashed { stroke-dasharray: 6 6; fill: transparent; }
  .boundary-label { fill: var(--text-muted); font: 600 12px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .node rect { fill: var(--bg-raised); stroke: var(--line-strong); stroke-width: 1.5; }
  .node.accent rect { stroke: var(--accent); fill: rgba(45, 212, 191, 0.07); }
  .node.ghost rect { stroke-dasharray: 4 4; fill: transparent; }
  .node .title { fill: var(--text); font: 700 14px var(--mono); text-anchor: middle; }
  .node .sub { fill: var(--text-muted); font: 11.5px var(--mono); text-anchor: middle; }
  .edge { fill: none; stroke: #5b6b7c; stroke-width: 1.6; }
  .edge.strong { stroke: var(--accent); stroke-width: 2; }
  .dashed-edge { stroke-dasharray: 5 5; }
  .arrowhead { fill: #8a9aab; }
  .edge-label { fill: var(--text-muted); font: 11px var(--mono); }
  .sec { margin-top: 48px; }
  .layers { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .layer { color: var(--accent); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 4px; }
  .layers ul { margin: 0; padding-left: 1.1em; color: var(--text-muted); font-size: 0.93rem; }
  .layers li { margin: 0.3em 0; }
  .note { margin-top: 28px; font-size: 0.85rem; }
  code { font-family: var(--mono); background: var(--bg-sunken); border: 1px solid var(--line); padding: 1px 6px; border-radius: 4px; }
</style>
